    {
      "name": "Project Canvas",
      "kind": "card",
      "refersTo": "project-canvas",
      "description": "A framed editorial study turns documented project facts into an information composition.",
      "html": "<section class=\"ds-canvas\" aria-label=\"Project field study\"><p class=\"ds-canvas-meta\">FILE 01 / 04 · FIELD STUDY</p><figure class=\"ds-study\"><div class=\"ds-study-title\"><span>VALUE / INPUTS</span><strong>From vehicle<br>to valuation.</strong><small>R—01</small></div><div class=\"ds-study-facts\"><span>FOUR VEHICLE CLASSES</span><p>Cars · Motorcycles · Trucks · Commercial</p></div><figcaption>Editorial study · composed from documented project details</figcaption></figure></section>",
      "css": ".ds-canvas{padding:clamp(18px,2vw,31px);background:var(--surface);color:var(--ink);font-family:var(--sans)}.ds-canvas-meta{margin:0 0 12px;color:var(--muted-readable);font-family:var(--mono);font-size:.58rem;letter-spacing:.1em}.ds-study{position:relative;display:grid;grid-template-columns:minmax(160px,.82fr) minmax(0,1.35fr);gap:clamp(12px,2vw,28px);min-height:300px;margin:0;padding:clamp(16px,3vw,32px);border:1px solid var(--rule);background:var(--surface-raised)}.ds-study-title{display:flex;flex-direction:column;justify-content:space-between;padding:clamp(16px,2vw,28px);background:var(--orange);color:var(--ink)}.ds-study-title span,.ds-study-title small{font-family:var(--mono);font-size:.58rem;letter-spacing:.08em}.ds-study-title strong{max-width:8ch;font-family:var(--display);font-size:clamp(2.4rem,5vw,4rem);font-weight:500;letter-spacing:-.055em;line-height:.8}.ds-study-facts{padding:18px;border:1px solid var(--rule);background:var(--paper)}.ds-study-facts span{font-family:var(--mono);font-size:.62rem;letter-spacing:.08em}.ds-study-facts p{margin-top:24px;font-size:.9rem}.ds-study figcaption{position:absolute;right:10px;bottom:8px;color:var(--muted-readable);font-family:var(--mono);font-size:.48rem;letter-spacing:.04em;text-transform:uppercase}"
