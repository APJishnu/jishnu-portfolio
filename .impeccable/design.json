      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Filter projects by type\"><button type=\"button\" aria-pressed=\"true\">All work</button><button type=\"button\" aria-pressed=\"false\">Independent</button><button type=\"button\" aria-pressed=\"false\">Company work</button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:6px}.ds-filters button{min-height:32px;padding:0 9px;border:1px solid var(--rule-soft);border-radius:0;background:transparent;color:var(--muted-readable);font-family:var(--mono);font-size:.57rem;cursor:pointer}.ds-filters button:hover,.ds-filters button[aria-pressed=true]{border-color:var(--ink);background:var(--ink);color:var(--paper)}.ds-filters button:focus-visible{outline:2px solid var(--focus);outline-offset:4px}"
