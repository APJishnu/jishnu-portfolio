      "name": "Desktop Navigation",
      "kind": "nav",
      "refersTo": "desktop-nav-link",
      "description": "Compact route links with a short orange underline on hover and for the current route.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#\" aria-current=\"page\">Work</a><a href=\"#\">Experience</a><a href=\"#\">About</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:clamp(15px,2.2vw,35px)}.ds-nav a{position:relative;display:inline-flex;align-items:center;min-height:44px;color:var(--muted-readable);font-family:var(--sans);font-size:.81rem;text-decoration:none;transition:color 160ms ease}.ds-nav a::after{position:absolute;right:0;bottom:8px;left:0;height:2px;background:var(--orange);content:\"\";transform:scaleX(0);transform-origin:left;transition:transform 180ms ease}.ds-nav a:hover,.ds-nav a[aria-current=page]{color:var(--ink)}.ds-nav a:hover::after,.ds-nav a[aria-current=page]::after{transform:scaleX(1)}.ds-nav a:focus-visible{outline:2px solid var(--focus);outline-offset:4px}"
    },
    {
      "name": "Project Index Row",
      "kind": "custom",
      "refersTo": "project-index-row",
      "description": "A numbered record links project identity and context to the selected study.",
      "html": "<a class=\"ds-index-row is-selected\" href=\"#\" aria-current=\"true\"><span class=\"ds-index-number\">01</span><span class=\"ds-index-copy\"><strong>Revalo</strong><small>Independent product</small></span><span class=\"ds-index-period\">FIELD STUDY</span></a>",
      "css": ".ds-index-row{display:grid;grid-template-columns:31px minmax(0,1fr) auto;align-items:center;min-height:58px;padding:9px 0;border-bottom:1px dotted var(--rule-soft);color:var(--ink);font-family:var(--sans);text-decoration:none;transition:transform 180ms ease,background-color 180ms ease}.ds-index-row:hover,.ds-index-row:focus-visible{transform:translateX(4px);background:color-mix(in srgb,var(--orange) 7%,transparent)}.ds-index-row:focus-visible{outline:2px solid var(--focus);outline-offset:4px}.ds-index-number,.ds-index-period{color:var(--muted-readable);font-family:var(--mono);font-size:.64rem;font-variant-numeric:tabular-nums}.ds-index-row.is-selected .ds-index-number{color:var(--accent-ink)}.ds-index-copy{display:flex;min-width:0;flex-direction:column;gap:1px}.ds-index-copy strong{color:var(--ink);font-size:.92rem;font-weight:600;letter-spacing:.015em}.ds-index-copy small{color:var(--muted-readable);font-size:.7rem}.ds-index-period{text-align:right;letter-spacing:.04em}"
    },
    {
